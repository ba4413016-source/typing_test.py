# Local development can omit DATABASE_URL and uses data/local.db.
# On Render, set the INTERNAL PostgreSQL URL in the service Environment.
DATABASE_URL=

# Optional custom domain. Render's RENDER_EXTERNAL_URL is used automatically.
PUBLIC_URL=

# Both are required to create the initial administrator. No default credentials.
# Used only when creating a NEW admin, never to overwrite an existing account.
ADMIN_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Secure defaults to true on ALL hosts. False is rejected on Render/HTTPS PUBLIC_URL.
# For local HTTP development ONLY, explicitly export SESSION_COOKIE_SECURE=false.
# This example file is documentation; it is not automatically loaded.
